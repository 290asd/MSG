diff --git a/src/msg-theme.css b/src/msg-theme.css
new file mode 100644
index 0000000..2419f09
--- /dev/null
+++ b/src/msg-theme.css
@@ -0,0 +1,103 @@
+/* MSG: joi.how in MSG's look (liquid glass over the favorites page). Loaded after index.css,
+   so these replace joi.how's own colors. The theme follows MSG's (html[data-theme], set by msg.ts). */
+
+:root,
+:root[data-theme='dark'] {
+  --background: transparent;
+  --text-color: #f3f5f9;
+
+  --overlay-background: rgba(22, 25, 32, 0.6);
+  --overlay-color: #f3f5f9;
+
+  --primary: #4ea4ff;
+
+  --card-background: rgba(22, 25, 32, 0.55);
+  --card-color: #f3f5f9;
+
+  --section-background: rgba(255, 255, 255, 0.06);
+
+  --button-background: rgba(255, 255, 255, 0.1);
+  --button-color: #f3f5f9;
+
+  --legend-background: rgba(255, 255, 255, 0.12);
+  --legend-color: #a2abbb;
+  --msg-field-border: rgba(255, 255, 255, 0.1);
+
+  --msg-glass-border: rgba(255, 255, 255, 0.13);
+  --msg-glass-highlight: rgba(255, 255, 255, 0.2);
+  --msg-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
+
+  --border-radius: 22px;
+
+  --wa-color-text-quiet: #a2abbb;
+  --wa-font-family-body: 'Segoe UI Variable Text', 'Segoe UI', system-ui, sans-serif;
+  --wa-border-radius-scale: 1.6;
+  --wa-form-control-border-color: rgba(255, 255, 255, 0.14);
+  --wa-form-control-background-color: rgba(255, 255, 255, 0.08);
+  --wa-form-control-height: 2.25rem;
+
+  color-scheme: dark;
+}
+
+:root[data-theme='light'] {
+  --text-color: #121620;
+  --primary: #0a74e0;
+  --card-background: rgba(255, 255, 255, 0.55);
+  --card-color: #121620;
+  --section-background: rgba(20, 30, 50, 0.05);
+  --button-background: rgba(20, 30, 50, 0.08);
+  --button-color: #121620;
+  --legend-background: rgba(20, 30, 50, 0.1);
+  --legend-color: #5a6475;
+  --msg-field-border: rgba(20, 30, 50, 0.1);
+  --msg-glass-border: rgba(255, 255, 255, 0.75);
+  --msg-glass-highlight: rgba(255, 255, 255, 0.95);
+  --msg-shadow: 0 12px 34px rgba(30, 40, 60, 0.18);
+  --wa-color-text-quiet: #5a6475;
+  --wa-form-control-border-color: rgba(20, 30, 50, 0.14);
+  --wa-form-control-background-color: rgba(20, 30, 50, 0.06);
+
+  color-scheme: light;
+}
+
+html,
+body {
+  background: transparent;
+}
+
+body {
+  font-size: 15px;
+}
+
+/* Dialogs (game settings, events) and the game's overlays blur the game image behind them. */
+wa-dialog::part(dialog) {
+  background: var(--card-background);
+  backdrop-filter: blur(28px) saturate(170%);
+  border: 1px solid var(--msg-glass-border);
+  box-shadow: var(--msg-shadow), inset 0 1px 0 var(--msg-glass-highlight);
+  border-radius: 22px;
+}
+
+wa-button::part(base) {
+  border-radius: 999px;
+}
+
+wa-button[variant='brand']::part(base),
+wa-button[appearance='accent']::part(base) {
+  font-weight: 600;
+}
+
+/* Like MSG: no scrollbars. */
+::-webkit-scrollbar {
+  display: none;
+}
+
+wa-slider::part(track) {
+  background: var(--button-background);
+}
+
+/* Scroll areas inside joi.how's components (shadow DOM) too. */
+* ,
+wa-dialog::part(body) {
+  scrollbar-width: none;
+}
diff --git a/src/msg.ts b/src/msg.ts
new file mode 100644
index 0000000..9b97286
--- /dev/null
+++ b/src/msg.ts
@@ -0,0 +1,26 @@
+// MSG: joi.how runs in a panel on MSG's favorites page (an iframe of this build).
+
+// Follow MSG's light/dark theme.
+const syncTheme = () => {
+  try {
+    document.documentElement.dataset.theme =
+      window.parent.document.documentElement.dataset.theme || 'dark';
+  } catch {
+    document.documentElement.dataset.theme = 'dark';
+  }
+};
+syncTheme();
+try {
+  new MutationObserver(syncTheme).observe(
+    window.parent.document.documentElement,
+    { attributes: true, attributeFilter: ['data-theme'] }
+  );
+} catch {
+  // not inside MSG
+}
+
+// Esc closes the panel, unless it closes one of joi.how's own dialogs.
+window.addEventListener('keydown', e => {
+  if (e.key === 'Escape' && !document.querySelector('wa-dialog[open]'))
+    window.parent.postMessage('msg-joi-close', '*');
+});
